{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Infrastructure cash-flow project v1.0",
  "description": "Structural schema. The Python validator additionally checks consecutive months, chronological relations, finite values and financing consistency.",
  "type": "object",
  "required": [
    "schema_version",
    "project_id",
    "synthetic_data",
    "currency",
    "amount_unit",
    "as_of",
    "baseline_vintage",
    "financing",
    "baseline",
    "actuals"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "synthetic_data": {
      "type": "boolean"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "amount_unit": {
      "const": "million"
    },
    "as_of": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
    },
    "baseline_vintage": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
    },
    "operations_start": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
    },
    "financing": {
      "type": "object",
      "required": [
        "opening_cash",
        "opening_debt",
        "opening_cumulative_drawn",
        "facility_limit",
        "minimum_cash",
        "annual_interest_rate",
        "availability_end"
      ],
      "properties": {
        "opening_cash": {
          "type": "number",
          "minimum": 0
        },
        "opening_debt": {
          "type": "number",
          "minimum": 0
        },
        "opening_cumulative_drawn": {
          "type": "number",
          "minimum": 0
        },
        "facility_limit": {
          "type": "number",
          "minimum": 0
        },
        "minimum_cash": {
          "type": "number",
          "minimum": 0
        },
        "annual_interest_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "availability_end": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
        }
      }
    },
    "baseline": {
      "type": "array",
      "minItems": 1,
      "maxItems": 600,
      "items": {
        "type": "object",
        "required": [
          "month",
          "receipts",
          "capex",
          "opex",
          "tax",
          "maintenance_capex",
          "equity",
          "principal"
        ],
        "properties": {
          "month": {
            "type": "string",
            "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
          },
          "receipts": {
            "type": "number",
            "minimum": 0
          },
          "capex": {
            "type": "number",
            "minimum": 0
          },
          "opex": {
            "type": "number",
            "minimum": 0
          },
          "tax": {
            "type": "number",
            "minimum": 0
          },
          "maintenance_capex": {
            "type": "number",
            "minimum": 0
          },
          "equity": {
            "type": "number",
            "minimum": 0
          },
          "principal": {
            "type": "number",
            "minimum": 0
          }
        },
        "additionalProperties": false,
        "not": {
          "anyOf": [
            {
              "required": [
                "debt_draw"
              ]
            },
            {
              "required": [
                "interest"
              ]
            }
          ]
        }
      }
    },
    "actuals": {
      "type": "array",
      "minItems": 1,
      "maxItems": 600,
      "items": {
        "type": "object",
        "required": [
          "month",
          "receipts",
          "capex",
          "opex",
          "tax",
          "maintenance_capex",
          "equity",
          "principal"
        ],
        "properties": {
          "month": {
            "type": "string",
            "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
          },
          "receipts": {
            "type": "number",
            "minimum": 0
          },
          "capex": {
            "type": "number",
            "minimum": 0
          },
          "opex": {
            "type": "number",
            "minimum": 0
          },
          "tax": {
            "type": "number",
            "minimum": 0
          },
          "maintenance_capex": {
            "type": "number",
            "minimum": 0
          },
          "equity": {
            "type": "number",
            "minimum": 0
          },
          "principal": {
            "type": "number",
            "minimum": 0
          },
          "debt_draw": {
            "type": "number",
            "minimum": 0
          },
          "interest": {
            "type": "number",
            "minimum": 0
          }
        },
        "additionalProperties": false,
        "dependentRequired": {
          "debt_draw": [
            "interest"
          ],
          "interest": [
            "debt_draw"
          ]
        }
      }
    }
  }
}
